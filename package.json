{
  "name": "vault-personal-library",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "backend:check": "node --check backend/src/index.js && node --check backend/src/oauth.js && node --check backend/src/session.js",
    "backend:test": "node --test backend/test/*.test.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "dev:source": "node scripts/serve.mjs --source",
    "vendor:icons": "node scripts/vendor-icons.mjs",
    "test": "node --test tests/*.test.mjs backend/test/*.test.mjs",
    "check": "node --check app.js && node --check modules/local-store.js && node --check modules/interface.js && npm run backend:check"
  },
  "dependencies": {
    "lucide": "1.43.0"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6"
  }
}
